6. COMPLETE PYTHON IMPLEMENTATION MODULE
--------------------------------------------------------------------------------
import numpy as np

class IntegratedT6Engine:
    """Calculates T6 aging kinetics, thermal lag, and AMS 2770 compliance."""

    ALLOY_SPECS = {
        "AA6061": {"T_std": 175.0, "t_min": 8.0, "t_max": 12.0, "hv_spec": 95.0, "hv_max": 105.0, "hv_ann": 30.0, "cr_crit": 18.0},
        "AA6082": {"T_std": 175.0, "t_min": 6.0, "t_max": 10.0, "hv_spec": 100.0, "hv_max": 112.0, "hv_ann": 35.0, "cr_crit": 30.0},
        "AA6063": {"T_std": 180.0, "t_min": 5.0, "t_max": 8.0, "hv_spec": 75.0, "hv_max": 82.0, "hv_ann": 25.0, "cr_crit": 3.0}
    }

    @classmethod
    def evaluate_t6_cycle(
        cls,
        alloy: str,
        avg_cooling_rate: float,
        t_natural_delay_hours: float,
        furnace_temp_c: float,
        total_cycle_time_hours: float,
        thickness_mm: float = 12.5
    ) -> dict:
        spec = cls.ALLOY_SPECS.get(alloy, cls.ALLOY_SPECS["AA6082"])

        # Thermal mass lag & reversion lag
        ramp_lag_h = (thickness_mm * 1.5) / 60.0
        soak_eff_h = max(0.0, total_cycle_time_hours - ramp_lag_h)
        reversion_h = 0.8 * (1.0 - np.exp(-t_natural_delay_hours / 18.0))
        kinetic_soak_h = max(0.0, soak_eff_h - reversion_h)

        # Solute retention fraction
        tau_est = 0.05 * (spec["cr_crit"] / max(avg_cooling_rate, 0.1)) ** 1.8
        f_s = np.exp(-0.005013 * tau_est)

        # Precipitation kinetics
        tau_peak = 6.5 if alloy != "AA6063" else 5.5
        ratio = kinetic_soak_h / tau_peak if tau_peak > 0 else 0
        fraction = (2.0 * (ratio ** 0.5)) / (1.0 + (ratio ** 1.5)) if ratio > 0 else 0.0

        na_penalty = 1.0 - 0.05 * (1.0 - np.exp(-t_natural_delay_hours / 24.0))
        hv_pred = spec["hv_ann"] + (spec["hv_max"] - spec["hv_ann"]) * f_s * na_penalty * fraction

        max_safe_cr = 120.0 / (1.0 + 0.05 * thickness_mm)
        is_safe = avg_cooling_rate <= max_safe_cr
        is_temp = abs(furnace_temp_c - spec["T_std"]) <= 5.0
        is_soak = spec["t_min"] <= soak_eff_h <= spec["t_max"]
        is_hv = hv_pred >= spec["hv_spec"]

        return {
            "ams_2770_verdict": "PASS" if (is_safe and is_temp and is_soak and is_hv) else "FAIL",
            "predicted_hv": float(hv_pred),
            "solute_retention_pct": float(f_s * 100.0),
            "reversion_delay_h": float(reversion_h),
            "max_safe_cr": float(max_safe_cr)
        }

